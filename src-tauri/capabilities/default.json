{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the Macleaner popover window",
  "windows": ["main"],
  "platforms": ["macOS"],
  "permissions": [
    "core:default",
    "positioner:allow-move-window",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://127.0.0.1:11434/**" },
        { "url": "http://localhost:11434/**" }
      ]
    }
  ]
}
