{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Macleaner",
  "version": "0.2.1",
  "identifier": "com.macleaner.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Macleaner",
        "width": 380,
        "height": 480,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'",
      "capabilities": ["default"]
    }
  },
  "plugins": {
    "http": {
      "scopeRedirects": true
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRBMEMzODNGQUQwRTIyNzQKUldSMElnNnRQemdNU3BlTmgyYUc5UFliOS9FaHZ6WDNnZDBNTW9LQUtMVDNCQUtuR2c5Qm1UTlMK",
      "endpoints": [
        "https://github.com/vicode360/macleaner/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
